<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: Cloud-Backup und Gerätewechsel. Token-Datei und Tink-Keyset bleiben auf dem
     Gerät (Entscheidung #7); Server und Username (session.preferences_pb) dürfen mit. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/session_tokens.pb" />
        <exclude domain="sharedpref" path="session_keyset.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/session_tokens.pb" />
        <exclude domain="sharedpref" path="session_keyset.xml" />
    </device-transfer>
</data-extraction-rules>
